# PostgreSQL / Supabase pooler URL. Use sslmode=require for cloud deployments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_SSL=disable
DB_POOL_MAX=10
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Better Auth: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Dedicated key for AES-GCM encryption of payment credentials. Keep stable across deploys.
DATA_ENCRYPTION_KEY=replace_with_another_32_character_random_secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000
# Enable only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false

# Server-only allowlist. A listed user must also have a verified email and 2FA enabled.
SUPER_ADMIN_EMAILS=

# Optional OAuth providers; each provider activates only when both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional Supabase services (Storage/Realtime). Service role is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional inbound/outbound webhook signing secret.
WEBHOOK_SECRET=

# Payments (adapters activate only when credentials exist).
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_BASE_URL=https://api.doku.com
# Notification providers.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TELEGRAM_BOT_TOKEN=
# resend | sendgrid | generic. EMAIL_FROM is required for Resend/SendGrid.
EMAIL_PROVIDER=generic
EMAIL_FROM=
EMAIL_API_URL=
EMAIL_API_KEY=

# AI provider using an OpenAI-compatible /chat/completions endpoint.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# Error monitoring (optional). Requires: npm install @sentry/nextjs
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional distributed API rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Logging level: debug | info | warn | error (default: info)
LOG_LEVEL=info
