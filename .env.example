# PostgreSQL / Supabase pooler URL. Use sslmode=require for cloud deployments.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
DATABASE_SSL=disable
DB_POOL_MAX=10
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Better Auth: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# Optional OAuth providers; each provider activates only when both values exist.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Optional Supabase services (Storage/Realtime). Service role is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional inbound/outbound webhook signing secret.
WEBHOOK_SECRET=

# Payments (adapters activate only when credentials exist).
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
XENDIT_SECRET_KEY=

# Notification providers.
WHATSAPP_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
EMAIL_API_URL=
EMAIL_API_KEY=

# AI provider using an OpenAI-compatible /chat/completions endpoint.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-sonnet-5
